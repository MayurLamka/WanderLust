
<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= process.env.MAP_TOKEN %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>

<div class="container show-page">

    <!-- Listing title -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">
            <h3 class="show-title">
                <%= listing.title %>
            </h3>
        </div>
    </div>

    <!-- Listing card -->
    <div class="row justify-content-center">
        <div class="col-12 col-md-10 col-lg-8">

            <div class="card listing-card show-card">

                <img
                    src="<%= listing.image.url %>"
                    class="card-img-top show-img"
                    alt="Listing image"
                >

                <div class="card-body">

                    <p class="card-text">
                        <i>Owned by <%= listing.owner.username %></i>
                    </p>

                    <p class="card-text category">
                        Category: <%= listing.category %>
                    </p>

                    <p class="card-text">
                        <%= listing.description %>
                    </p>

                    <p class="card-text">
                        &#8377; <%= listing.price.toLocaleString("en-IN") %>
                    </p>

                    <p class="card-text">
                        <%= listing.location %>
                    </p>

                    <p class="card-text">
                        <%= listing.country %>
                    </p>

                </div>
            </div>

            <!-- Edit and Delete buttons -->
            <% if (currUser && currUser._id.equals(listing.owner._id)) { %>

                <div class="btns mb-3">

                    <a
                        href="/listings/<%= listing._id %>/edit"
                        class="btn btn-dark"
                    >
                        Edit
                    </a>

                    <form
                        method="POST"
                        action="/listings/<%= listing._id %>?_method=DELETE"
                    >
                        <button class="btn btn-dark">
                            Delete
                        </button>
                    </form>

                </div>

            <% } %>

        </div>
    </div>

    <!-- Review section -->
    <div class="row justify-content-center review-section">

        <div class="col-12 col-md-10 col-lg-8">

            <% if (currUser) { %>

                <hr>

                <h4>Leave a Review</h4>

                <form
                    action="/listings/<%= listing._id %>/reviews"
                    method="POST"
                    novalidate
                    class="needs-validation"
                >

                    <fieldset class="starability-slot">

                        <legend>Give rating:</legend>

                        <input
                            type="radio"
                            id="no-rate"
                            class="input-no-rate"
                            name="review[rating]"
                            value="1"
                            checked
                        />

                        <% for (let i = 1; i <= 5; i++) { %>

                            <input
                                type="radio"
                                id="first-rate<%= i %>"
                                name="review[rating]"
                                value="<%= i %>"
                            />

                            <label
                                for="first-rate<%= i %>"
                                title="<%= i %> stars"
                            >
                                <%= i %> star<%= i > 1 ? "s" : "" %>
                            </label>

                        <% } %>

                    </fieldset>

                    <div class="mb-3 mt-3">

                        <label for="comment" class="form-label">
                            Comments
                        </label>

                        <textarea
                            name="review[comment]"
                            id="comment"
                            rows="4"
                            class="form-control"
                            required
                            placeholder="Comment here..."
                        ></textarea>

                        <div class="invalid-feedback">
                            Please enter a comment.
                        </div>

                    </div>

                    <button class="btn btn-outline-dark mt-2">
                        Submit
                    </button>

                </form>

            <% } %>

            <!-- All reviews -->
            <% if (listing.reviews.length > 0) { %>

                <hr>

                <h4 class="mb-3">All Reviews</h4>

                <div class="row g-3">

                    <% for (let review of listing.reviews) { %>

                        <div class="col-12 col-md-6">

                            <div class="card review-card">

                                <div class="card-body">

                                    <h5 class="card-title">
                                        @<%= review.author.username %>
                                    </h5>

                                    <p
                                        class="starability-result card-text"
                                        data-rating="<%= review.rating %>"
                                    ></p>

                                    <p class="card-text">
                                        <%= review.comment %>
                                    </p>

                                    <% if (
                                        currUser &&
                                        currUser._id.equals(review.author._id)
                                    ) { %>

                                        <form
                                            method="POST"
                                            action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE"
                                        >

                                            <button class="btn btn-sm btn-dark">
                                                Delete
                                            </button>

                                        </form>

                                    <% } %>

                                </div>
                            </div>

                        </div>

                    <% } %>

                </div>

            <% } %>

        </div>
    </div>

    <!-- Map section -->
    <div class="row justify-content-center map-section">

        <div class="col-12 col-md-10 col-lg-8">

            <h3>Where you will be</h3>

            <div id="map"></div>

        </div>

    </div>

</div>

<script src="/js/map.js"></script>
